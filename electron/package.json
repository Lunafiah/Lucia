{
  "name": "lucia-desktop",
  "version": "1.0.0",
  "description": "Lucia Desktop Companion Interface",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.lucia.companion",
    "productName": "Lucia",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "keywords": [
    "ai",
    "companion",
    "lucia",
    "electron"
  ],
  "author": "Lucia Core Team",
  "license": "MIT"
}
